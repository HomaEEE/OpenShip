# ==============================================================================
# OpenShip Shared Services — MariaDB + Redis + phpMyAdmin Configuration
# ==============================================================================

# MariaDB Docker image tag (LTS: 11.4)
MARIADB_VERSION=11.4

# MariaDB root password (REQUIRED: set a strong password)
DB_ROOT_PASSWORD=
MARIADB_ROOT_PASSWORD=${DB_ROOT_PASSWORD}

# InnoDB Buffer Pool Size (default: 256M, for 2GB VPS recommend 128M - 256M)
MARIADB_BUFFER_POOL_SIZE=256M

# InnoDB Redo Log Size (default: 128M)
MARIADB_LOG_FILE_SIZE=128M

# Maximum concurrent connections
MARIADB_MAX_CONNECTIONS=150

# Slow query log (1 = enabled, 0 = disabled)
MARIADB_SLOW_QUERY_LOG=1
MARIADB_LONG_QUERY_TIME=2

# Container memory limits
MARIADB_MEMORY_LIMIT=1024M
REDIS_MEMORY_LIMIT=512M

# Redis Docker image tag
REDIS_VERSION=7.4-alpine

# Redis auth password (REQUIRED: set your redis password)
REDIS_PASSWORD=

# Redis eviction policy (default: noeviction — protects queues and sessions)
# Use 'allkeys-lru' or 'volatile-lru' only when using Redis exclusively as cache
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=noeviction

# phpMyAdmin Configuration (database web manager for OpenShip OpenResty Edge proxy)
ENABLE_PHPMYADMIN=true
PHPMYADMIN_VERSION=latest
PHPMYADMIN_HOST=mariadb
PHPMYADMIN_PORT=20003
PHPMYADMIN_BIND_IP=127.0.0.1
PHPMYADMIN_UPLOAD_LIMIT=512M
PHPMYADMIN_MEMORY_LIMIT=256M

# Shared Docker Network (User-defined bridge with Docker DNS & Static IPs)
OPENSHIP_NETWORK=openship-mariadb
OPENSHIP_SUBNET=172.20.0.0/16
OPENSHIP_GATEWAY=172.20.0.1

# Static IP addresses within OPENSHIP_NETWORK
MARIADB_STATIC_IP=172.20.0.10
REDIS_STATIC_IP=172.20.0.11
PHPMYADMIN_STATIC_IP=172.20.0.12
