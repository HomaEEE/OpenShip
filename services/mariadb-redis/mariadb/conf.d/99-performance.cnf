# ==============================================================================
# MariaDB High-Performance Configuration for Web/SaaS & FrankenPHP Workers
# ==============================================================================

[mysqld]
# Storage Engine & Buffer Pool
default_storage_engine          = InnoDB
innodb_buffer_pool_size         = 256M
innodb_buffer_pool_instances    = 1
innodb_log_file_size            = 64M
innodb_log_buffer_size          = 16M

# I/O & CPU Optimization
# Flush to OS cache on commit, flush to disk once per second (huge CPU & I/O boost)
innodb_flush_log_at_trx_commit  = 2
innodb_flush_method             = O_DIRECT
innodb_io_capacity              = 2000
innodb_io_capacity_max          = 4000
innodb_read_io_threads          = 4
innodb_write_io_threads         = 4

# Disable Performance Schema (saves 10-15% CPU and 100MB+ RAM on VPS)
performance_schema              = OFF

# Connection & Thread Tuning (Optimized for FrankenPHP persistent connections)
skip_name_resolve               = 1
max_connections                 = 30
max_connect_errors              = 10000
thread_cache_size               = 16
wait_timeout                    = 600
interactive_timeout             = 600

# Table & File Caches
table_open_cache                = 1024
table_definition_cache          = 512
open_files_limit                = 65535

# Query Optimization
tmp_table_size                  = 16M
max_heap_table_size             = 16M
join_buffer_size                = 1M
sort_buffer_size                = 1M
read_rnd_buffer_size            = 512K
