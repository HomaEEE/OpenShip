{
  "$schema": "https://openship.io/openship.schema.json",
  "framework": "docker-compose",
  "composePath": "services/mariadb-redis/docker-compose.yml",
  "volumes": ["mariadb_data", "redis_data"],
  "env": {
    "MARIADB_ROOT_PASSWORD": {
      "value": "",
      "secret": true
    },
    "REDIS_PASSWORD": {
      "value": "",
      "secret": true
    },
    "ENABLE_PHPMYADMIN": {
      "value": "true",
      "secret": false
    },
    "PHPMYADMIN_PORT": {
      "value": "20003",
      "secret": false
    }
  }
}
